# ─── JobIQ Environment Variables ─────────────────────────────────────────────
# Copy to .env.local. EVERY variable is optional — with none set, the app runs
# fully in demo mode (demo user, mock jobs from all three sources).
# Remove the old ONLINEJOBS_SESSION_COOKIE if present — connections now live
# in the database, per user.

# ── Supabase (JobIQ accounts + database) ─────────────────────────────────────
# Create a project at https://supabase.com, then run
# supabase/migrations/0001_jobiq_v1.sql in the SQL editor.
# Without these, the app runs in demo mode (demo user, nothing persisted).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Admin console (/admin) ───────────────────────────────────────────────────
# Who can open /admin and activate paying customers — comma-separated emails.
# Anyone not listed gets a 404, so leaving this blank disables the console.
ADMIN_EMAILS=

# Service-role key from Supabase → Settings → API Keys → service_role.
# SECRET — full database access, bypasses row-level security. Server-side only;
# never prefix it with NEXT_PUBLIC_. Required for the admin console to create
# and activate customer accounts.
SUPABASE_SERVICE_ROLE_KEY=

# ── Scraping Mode ─────────────────────────────────────────────────────────────
# Set to "false" to enable live scraping. Default is "true" (safe for Vercel
# deployment — uses realistic mock data from all three sources).
DEMO_MODE=true

# ── Apify (LinkedIn + Upwork sources, full-access accounts) ──────────────────
# Token from https://console.apify.com/account/integrations (paid usage).
# Actor slugs are overridable — verify your chosen actors on the Apify Store
# and do one console test-run each to confirm the input keys.
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR=valig~linkedin-jobs-scraper
APIFY_UPWORK_ACTOR=neatrat~upwork-job-scraper

# ── AI Analysis & Personalization ─────────────────────────────────────────────
# Free API key from https://openrouter.ai
# Without this (and without ANTHROPIC_API_KEY below), the app uses local
# regex/template heuristics — works fine for demo.
OPENROUTER_API_KEY=

# Optional — if set, Claude Haiku is used for cover-letter personalization
# and question generation instead of/before OpenRouter.
ANTHROPIC_API_KEY=

# ── OnlineJobs.ph connection encryption ──────────────────────────────────────
# 64 hex chars (32 bytes). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OJ_SESSION_ENCRYPTION_KEY=

# ── Email Delivery (optional — simulated if not set) ─────────────────────────
# Gmail SMTP with an App Password.
# Steps to get an App Password:
#   1. Enable 2FA on your Google account
#   2. Go to myaccount.google.com → Security → App Passwords
#   3. Generate a password for "Mail"
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password-here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Last-resort fallback recipient. The email digest normally defaults to the
# signed-in account's email — only set this if you want a fixed override.
TO_EMAIL=

# ── Where "Get full access" sends buyers ─────────────────────────────────────
# Your Facebook page, a Messenger link (m.me/yourpage), or later a PayMongo
# payment link. Swap it any time without a code change. If unset, the button
# falls back to a Facebook search for the page.
NEXT_PUBLIC_BUY_URL=

# ── Public address of the app ────────────────────────────────────────────────
# Used for links in emails and for OAuth redirects behind Render's proxy.
# e.g. https://easyclients.com
NEXT_PUBLIC_APP_URL=

# ── Google sign-in on your own domain ────────────────────────────────────────
# Without this, Google's prompt reads "Sign in to <project>.supabase.co", which
# looks untrustworthy to new users. Set it to the OAuth Client ID from Google
# Cloud, and add your site's address to that client's "Authorized JavaScript
# origins". Unset = falls back to the old redirect flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Manual payment details (shown on /get-access) ────────────────────────────
# A method only appears once its details are filled in, so you can launch with
# GCash alone. These are public by design — an account number on a payment page.
NEXT_PUBLIC_GCASH_NAME=
NEXT_PUBLIC_GCASH_NUMBER=
NEXT_PUBLIC_BPI_NAME=
NEXT_PUBLIC_BPI_ACCOUNT=
NEXT_PUBLIC_GOTYME_NAME=
NEXT_PUBLIC_GOTYME_ACCOUNT=

# Which methods have a QR image uploaded to /public (qr-gcash.png, qr-bpi.png,
# qr-gotyme.png). Comma-separated, e.g. gcash,bpi — anything not listed shows
# the account number instead of a broken image.
NEXT_PUBLIC_QR_METHODS=

# Set to "true" once filipino-1.jpg … filipino-4.jpg are in /public.
# These are decorative images showing who the product is for — never
# testimonials, which stay out until real customers provide them.
NEXT_PUBLIC_HAS_PEOPLE_PHOTOS=

# Address shown on /privacy and /terms for data requests and support.
NEXT_PUBLIC_CONTACT_EMAIL=

# Where "a customer says they paid" emails go. Defaults to the first address in
# ADMIN_EMAILS. Claims are recorded in the database either way — this only
# decides whether anyone is told about them without opening /admin.
PAYMENT_NOTIFY_EMAIL=

# Card checkout link (Paddle or Lemon Squeezy). Leave blank and the Card tab
# simply does not appear.
#
# A Merchant of Record sells on our behalf and handles the tax, which is the
# only card route open without DTI or SEC registration. It also means card
# details never touch our servers. Set it up as a ONE-OFF product, not a
# subscription: "nothing renews automatically" is a promise made on the landing
# page, in the terms and in the privacy policy.
NEXT_PUBLIC_CARD_CHECKOUT_URL=

# Deep links that open a banking app from the payment page, as "scheme|intent".
# Only GCash ships with a default; the others are blank because their schemes
# are undocumented and a dead button on a payment page reads as a broken site.
# Fill one in after testing it on a real phone, e.g.
#   NEXT_PUBLIC_APPLINK_GOTYME=gotyme://|intent://#Intent;scheme=gotyme;package=...;end
NEXT_PUBLIC_APPLINK_GCASH=
NEXT_PUBLIC_APPLINK_BPI=
NEXT_PUBLIC_APPLINK_GOTYME=

# Overrides for the "Open GCash / BPI / GoTyme" buttons on the payment page.
# Format: id:scheme|android.package.name, comma separated. Only needed if a
# default turns out wrong on a real handset — none of them is verified.
#   NEXT_PUBLIC_APP_LINKS=gcash:gcash|com.globe.gcash.android
NEXT_PUBLIC_APP_LINKS=

# A link that opens the payment directly, per method. Leave blank and only the
# QR and account number show.
#
# Bare schemes like gcash:// do nothing — tested, no prompt on any handset. A
# working link carries a payment session, and three things produce one:
# GCash's own Request Money feature, a payment-link service, or a gateway like
# PayMongo (which needs DTI + BIR registration). All three hand back a URL.
NEXT_PUBLIC_GCASH_LINK=
NEXT_PUBLIC_BPI_LINK=
NEXT_PUBLIC_GOTYME_LINK=
